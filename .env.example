# Limitless OS – Schlüssel und Zugänge
# Diese Datei nach .env kopieren und ausfüllen. Die .env wird NIE ins Repo eingecheckt.
# Leere Zeilen = Station bleibt „nicht verbunden“ und bekommt keine Aufgaben.

# --- Shopify ----------------------------------------------------------------------
# Standardweg: der Shopify-MCP-Server in .mcp.json (Login im Browser über `claude` → /mcp → shopify).
# Dafür braucht es KEINE Schlüssel hier. Die drei Zeilen unten sind nur für den optionalen
# Datei-Upload (öffentliche Bild-Links für Metricool) nötig – Anleitung: docs/anleitung/shopify-app.md
SHOPIFY_STORE_DOMAIN=gexdm4-2q.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Printify (Zentrale: Aufträge, Produktionskosten, Marge) ----------------------------
# Printify → Mein Profil → Connections → Personal Access Tokens → neuen Token anlegen (nur Lesen nötig)
PRINTIFY_API_TOKEN=

# --- Metricool REST-API (optional, nur Advanced-Plan; der MCP-Server braucht das nicht) ---
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# --- Lokale Dienste (Phase 2) -----------------------------------------------------
COMFYUI_URL=http://127.0.0.1:8188
VOICESTUDIO_URL=http://127.0.0.1:3900

# --- Aufseher ------------------------------------------------------------------
# 1 = zusätzlich den undokumentierten Nutzungs-Endpunkt von Anthropic abfragen (Standard aus)
LIMITLESS_USAGE_PROBE=0
# Pfad zur claude-Binärdatei, falls nicht im PATH (normalerweise leer lassen)
LIMITLESS_CLAUDE_BIN=

# Metricool REST-API (Pflicht für automatisches Posten – der Adapter prüft vorher den Dubletten-Schutz).
# Metricool → Einstellungen → API. User-ID und Blog-ID stehen in der Planer-URL bzw. in Marke/Kanäle.md.
METRICOOL_API_KEY=
METRICOOL_USER_ID=5759175
METRICOOL_BLOG_ID=7412016

# ElevenLabs (optional, Stimme für Reels der Produktion)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Stimme – lokale Sprachausgabe (tools/stimme, kein Schlüssel nötig). Alles optional.
# Einrichten: powershell -ExecutionPolicy Bypass -File tools\stimme\install.ps1   (Anleitung: docs/anleitung/stimme.md)
STIMME_PORT=4243
STIMME_PYTHON=
STIMME_ENGINE=auto

